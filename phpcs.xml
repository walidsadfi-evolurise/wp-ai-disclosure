<?xml version="1.0"?>
<ruleset name="wp-ai-disclosure">
  <description>WordPress coding standards for the AI Disclosure plugin.</description>
  <file>wp-ai-disclosure.php</file>
  <file>uninstall.php</file>
  <file>includes</file>
  <arg name="extensions" value="php"/>
  <arg name="colors"/>
  <arg value="sp"/>
  <config name="minimum_wp_version" value="6.4"/>
  <config name="testVersion" value="8.1-"/>
  <rule ref="WordPress">
    <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
    <!-- Arrow alignment is cosmetic and fights with readable option maps; everything else in WPCS applies. -->
    <exclude name="WordPress.Arrays.MultipleStatementAlignment"/>
  </rule>
  <rule ref="PHPCompatibilityWP"/>
  <rule ref="WordPress.WP.I18n">
    <properties><property name="text_domain" type="array"><element value="wp-ai-disclosure"/></property></properties>
  </rule>
  <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
    <properties><property name="prefixes" type="array"><element value="wp_ai_disclosure"/><element value="WP_AI_DISCLOSURE"/><element value="WpAiDisclosure"/></property></properties>
  </rule>
  <rule ref="WordPress.Files.FileName">
    <properties><property name="strict_class_file_names" value="false"/></properties>
  </rule>
</ruleset>
